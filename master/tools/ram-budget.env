# Measured peaks (docs/RAM_BUDGET.md, 2026-11-06). Scheduler inputs; re-measure with tools/measure-ram.sh.
MEM_TOTAL_MB=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)

if [ "${MEM_TOTAL_MB:-0}" -lt 12000 ]; then
  # 8GB Host Recalibration (< 12000 MB MemTotal)
  PEAK_HEAVY_MIB=2048
  PEAK_LIGHT_MIB=512
  LPDF_RESERVE_G=1
  MIN_AVAIL_MIB=2200
  MAX_HEAVY_SLOTS=1
  export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
  export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=2048}"
  export VITEST_MAX_WORKERS="${VITEST_MAX_WORKERS:-2}"
else
  # 31GB Host Baseline
  PEAK_HEAVY_MIB=4096
  PEAK_LIGHT_MIB=1024
  LPDF_RESERVE_G=6
  MIN_AVAIL_MIB=8192
  MAX_HEAVY_SLOTS=2
  export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
  export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=3072}"
  export VITEST_MAX_WORKERS="${VITEST_MAX_WORKERS:-2}"
fi

